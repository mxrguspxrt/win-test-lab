# Big / generated / stateful things - never commit these.

# Installer ISOs (multi-GB; see docs/ISOS.md for how to get them). Default dir is iso-files/.
iso-files/
*.iso
*.ISO

# Built base images and lab 0-states (tens of GB)
images/
labs/state/

# Per-run scratch and results
runs/
results/
labs/*.log

# Screenshots / captured images (debug/scratch; regenerated per run)
*.png
*.jpg
*.jpeg
*.bmp
*.gif

# Built example artifacts (regenerated by their build.sh)
examples/**/*.zip
examples/**/out/
examples/demo/program.exe

# Python / editor
__pycache__/
*.pyc
.venv/
*.swp
.DS_Store
