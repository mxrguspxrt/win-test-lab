# Big / generated / stateful things - never commit these.

# Installer ISOs (multi-GB; see docs/ISOS.md for how to get them)
iso-files/
*.iso
*.ISO

# Built base images and lab 0 states (tens of GB)
images/
labs/state/

# Base-image build scratch
runs/

# virtio-win drivers for arm64 machines (Red Hat's, fetched by the user; see docs/ISOS.md)
drivers/

# A home's own settings: wtl init's wtl.json, your own ISO file names
/wtl.json
/images-list.conf

# Screenshots
*.png

# Built example programs (regenerated by their build.sh)
examples/**/out/
examples/**/*.zip

# Rust build output
/target/
/wtl/target/
/wtl/Cargo.lock

# Editor / OS / Python (tests/ps_lint.py)
__pycache__/
*.swp
.DS_Store
