#!/usr/bin/env python3
"""fake-qemu-img - stand-in for qemu-img used by tests/run-tests.sh.

  create [-q] [-f FMT] [-F BACKING_FMT] [-b BACKING] [-o opts] PATH [SIZE]   (any order)
  info [--output=json|human] [-f FMT] [--backing-chain] [-U] PATH
  check [-q] [-f FMT] [--output=json] PATH
  resize, convert, snapshot, commit, amend: accepted, minimal behaviour
  --version
Created files are a small qcow2-looking header: magic QFI\\xfb, version 3, backing
file name stored at offset 104 (as real qcow2), virtual size in the header.
Logs argv to $FAKE_QEMU_LOG if set.
"""
import json
import os
import re
import struct
import sys


def die(msg, code=1):
    sys.stderr.write("qemu-img: %s\n" % msg)
    sys.exit(code)


def parse_size(s):
    m = re.fullmatch(r"(\d+(?:\.\d+)?)([bBkKmMgGtT]?)", s.strip())
    if not m:
        die("Invalid image size specified. You may use k, M, G, T, P or E suffixes")
    mult = {"": 1, "b": 1, "k": 1 << 10, "m": 1 << 20, "g": 1 << 30, "t": 1 << 40}[m.group(2).lower()]
    return int(float(m.group(1)) * mult)


def write_qcow2(path, size, backing=None, backing_fmt=None):
    bk = (backing or "").encode()
    hdr = bytearray(512)
    hdr[0:4] = b"QFI\xfb"
    struct.pack_into(">I", hdr, 4, 3)                       # version
    struct.pack_into(">Q", hdr, 8, 104 if bk else 0)        # backing_file_offset
    struct.pack_into(">I", hdr, 16, len(bk))                # backing_file_size
    struct.pack_into(">I", hdr, 20, 16)                     # cluster_bits
    struct.pack_into(">Q", hdr, 24, size)                   # size
    struct.pack_into(">I", hdr, 100, 104)                   # header_length
    if bk:
        hdr[104:104 + len(bk)] = bk
    tail = b"FAKEQCOW2 backing_fmt=%s\n" % (backing_fmt or "").encode()
    with open(path, "wb") as f:
        f.write(bytes(hdr) + tail)


def read_qcow2(path):
    try:
        with open(path, "rb") as f:
            data = f.read(4096)
    except OSError as e:
        die("Could not open '%s': %s" % (path, e.strerror))
    if data[:4] != b"QFI\xfb":
        return {"format": "raw", "virtual-size": os.path.getsize(path), "backing": None}
    off = struct.unpack(">Q", data[8:16])[0]
    ln = struct.unpack(">I", data[16:20])[0]
    size = struct.unpack(">Q", data[24:32])[0]
    bk = data[off:off + ln].decode() if off and ln else None
    return {"format": "qcow2", "virtual-size": size, "backing": bk}


def main(argv):
    lp = os.environ.get("FAKE_QEMU_LOG")
    if lp:
        try:
            with open(lp, "a") as f:
                f.write(json.dumps({"pid": os.getpid(), "cwd": os.getcwd(), "argv": ["qemu-img"] + argv}) + "\n")
        except OSError:
            pass
    if not argv or argv[0] in ("-h", "--help", "help"):
        print("usage: qemu-img create|info|check|resize|convert ... (fake)")
        return 0
    if argv[0] in ("--version", "-V"):
        print("qemu-img version 8.2.2 (fake-qemu-img)")
        return 0
    cmd, rest = argv[0], argv[1:]
    opts, pos = {}, []
    flags = set()
    i = 0
    with_val = {"-f", "-F", "-b", "-o", "-O", "-B", "-l", "-s", "-t", "-T", "-r", "--output", "--object", "--image-opts"}
    while i < len(rest):
        a = rest[i]
        if a.startswith("--output="):
            opts["--output"] = a.split("=", 1)[1]
        elif a in with_val and a != "--image-opts":
            if i + 1 >= len(rest):
                die("option requires an argument -- '%s'" % a.lstrip("-"))
            opts[a] = rest[i + 1]
            i += 1
        elif a.startswith("-") and len(a) > 1 and not re.fullmatch(r"-\d.*", a):
            flags.add(a)
        else:
            pos.append(a)
        i += 1
    # -o backing_file=...,backing_fmt=...,size=...
    o = {}
    for p in opts.get("-o", "").split(","):
        if "=" in p:
            k, v = p.split("=", 1)
            o[k] = v
    if cmd == "create":
        fmt = opts.get("-f", "raw")
        backing = opts.get("-b", o.get("backing_file"))
        bfmt = opts.get("-F", o.get("backing_fmt"))
        if not pos:
            die("Expecting image file name")
        path = pos[0]
        size = None
        if len(pos) > 1:
            size = parse_size(pos[1])
        elif "size" in o:
            size = parse_size(o["size"])
        if backing:
            bpath = backing if os.path.isabs(backing) else os.path.join(os.path.dirname(os.path.abspath(path)), backing)
            if not os.path.exists(bpath):
                die("%s: Could not open '%s': No such file or directory" % (path, bpath))
            if fmt == "qcow2" and not bfmt:
                die("Backing file specified without backing format")
            if size is None:
                size = read_qcow2(bpath)["virtual-size"]
        if size is None:
            die("%s: Image creation needs a size parameter" % path)
        if fmt == "qcow2":
            write_qcow2(path, size, backing, bfmt)
        else:
            with open(path, "wb") as f:
                f.truncate(min(size, 1 << 20))
        if "-q" not in flags:
            print("Formatting '%s', fmt=%s size=%d%s" % (path, fmt, size,
                  (" backing_file=%s backing_fmt=%s" % (backing, bfmt)) if backing else ""))
        return 0
    if cmd == "info":
        if not pos:
            die("Expecting one image file name")
        path = pos[0]
        info = read_qcow2(path)
        out = {"filename": path, "format": info["format"], "virtual-size": info["virtual-size"],
               "actual-size": os.path.getsize(path), "dirty-flag": False}
        if info["backing"]:
            out["backing-filename"] = info["backing"]
            out["full-backing-filename"] = os.path.join(os.path.dirname(os.path.abspath(path)), info["backing"]) \
                if not os.path.isabs(info["backing"]) else info["backing"]
            out["backing-filename-format"] = "qcow2"
        if opts.get("--output") == "json":
            print(json.dumps([out] if "--backing-chain" in flags else out, indent=4))
        else:
            print("image: %s\nfile format: %s\nvirtual size: %d\ndisk size: %d"
                  % (path, out["format"], out["virtual-size"], out["actual-size"]))
            if info["backing"]:
                print("backing file: %s" % info["backing"])
        return 0
    if cmd == "check":
        if not pos:
            die("Expecting one image file name")
        info = read_qcow2(pos[0])
        if info["format"] != "qcow2":
            die("This image format does not support checks", 63)
        if opts.get("--output") == "json":
            print(json.dumps({"filename": pos[0], "format": "qcow2", "check-errors": 0}))
        elif "-q" not in flags:
            print("No errors were found on the image.")
        return 0
    if cmd in ("resize", "convert", "snapshot", "commit", "amend", "rebase", "measure", "map", "compare"):
        if cmd == "convert" and len(pos) >= 2:
            src, dst = pos[-2], pos[-1]
            info = read_qcow2(src)
            write_qcow2(dst, info["virtual-size"])
        return 0
    die("Command not found: %s" % cmd)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
